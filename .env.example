# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_your_bot_token_here
TELEGRAM_CHAT_ID=-1001234567890
# Comma-separated Telegram user IDs allowed to use the bot. Leave empty to allow all.
TELEGRAM_ADMIN_IDS=111111111,222222222
# Public base URL for webhook registration (e.g. https://your-app.onrender.com).
# Leave empty to use long polling (recommended for local development).
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# ── Database ───────────────────────────────────────────────────────────────────
# Any Postgres URL works — postgres://, postgresql://, or postgresql+asyncpg://
# are all normalized for the asyncpg driver automatically. A Neon or Supabase
# connection string can be pasted verbatim, including its ?sslmode=require&
# channel_binding=require suffix (translated to asyncpg's ssl= param for you).
# Neon free tier is recommended — unlike Render's free DB it does not expire.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/watcher

# ── Scheduler ─────────────────────────────────────────────────────────────────
CHECK_INTERVAL=1800
JITTER_SECONDS=120
REQUEST_TIMEOUT=20
MAX_CONCURRENT_FETCHES=3
# Sweep pacing + rate-limit guard. A sweep checks SWEEP_CONCURRENCY accounts at
# a time — 1 is one at a time, the same rhythm as a manual Recheck, which is the
# pattern Instagram's anonymous gate answers reliably. Every extra lane is a
# bigger burst, and bursts are what turn a handful of 401s into a screenful.
SWEEP_CONCURRENCY=1
# The gap between checks widens as consecutive 401/403 blocks pile up (up to the
# max). After THRESHOLD blocks in a row the sweep pauses for COOLDOWN seconds to
# let Instagram's short throttle window clear and carries on; only if the pauses
# don't help are the remaining accounts deferred to the next sweep. Threshold 0
# disables the guard; cooldown 0 defers immediately instead of pausing.
SWEEP_STAGGER_MAX_SECONDS=12
SWEEP_BREAKER_THRESHOLD=5
SWEEP_BREAKER_COOLDOWN_SECONDS=90
# Accounts still blocked at the end of a sweep are re-checked in this many
# rounds, one at a time, after a cooldown that doubles each round (30s, 60s,
# 120s). The gate blocks a REQUEST, not an account, so a paced retry usually
# goes straight through — this is what stops the summary from naming failures a
# manual Recheck can't reproduce. The rounds share one wall-clock budget. 0 off.
SWEEP_RETRY_ROUNDS=3
SWEEP_RETRY_BUDGET_SECONDS=300
# Hard cap on one sweep. Must clear the paced sweep plus the pauses and the
# retry budget above, or healthy sweeps get killed mid-flight. Keep it well
# under CHECK_INTERVAL.
SWEEP_TIMEOUT_SECONDS=1500

# ── Stakeout & Radar ───────────────────────────────────────────────────────────
# Stakeout = temporary high-frequency watch on one target. The min interval sits
# above the 90s reel cache so every tick is fresh without risking 401s.
STAKEOUT_DEFAULT_INTERVAL=180
STAKEOUT_MIN_INTERVAL=120
STAKEOUT_DEFAULT_DURATION=3600
STAKEOUT_MAX_DURATION=21600
# Flag a target after this many days with no story/post/reel. 0 disables.
DARK_RADAR_DAYS=3

# When a monitored account flips private -> public, auto-download its whole
# backlog (posts, reels, highlights, story) and send it. false = baseline only.
AUTO_GRAB_ON_PUBLIC=true

# Follower-anomaly alert: fires only when a follower change is large in BOTH
# absolute (≥ abs) and relative (≥ pct of prior count) terms, so it ignores a
# small account's noise and a big account's normal drift. Either 0 disables it.
FOLLOWER_ANOMALY_ABS_MIN=500
FOLLOWER_ANOMALY_PCT_MIN=0.10

# Digest roll-up. The mode (off/daily/weekly) is toggled at runtime with the
# /digest command; these only set WHEN a scheduled digest fires. Daily goes out
# every day at DIGEST_HOUR (UTC); weekly only on DIGEST_WEEKDAY (0=Monday).
DIGEST_HOUR=9
DIGEST_WEEKDAY=0

# Story/live status line ("HAS STORY" / "NO STORY" / "LIVE NOW") in every sweep.
# Off by default: a single story used to produce one of these per sweep for as
# long as it stayed up, on top of the "just posted a story!" alert and the story
# media itself. Off = the status is announced only when it CHANGES, and never on
# top of the media that already announced it. A manual Recheck always answers,
# and every status is logged for the digest either way. true = the old behavior.
STORY_STATUS_HEARTBEAT=false

# Give each monitored account its own forum topic (thread) when the chat is a
# Topics-enabled group and the bot is an admin with "Manage topics". Global
# messages stay in General. Off by default (everything goes to one chat).
TELEGRAM_FORUM_TOPICS=false
# Mirror a flat copy of every notification to extra chats (comma-separated).
# Handy to get alerts in your DM too while TELEGRAM_CHAT_ID is the forum group.
# Mirrors never use topics (DMs/non-forum chats can't). Empty = no mirroring.
# TELEGRAM_MIRROR_CHAT_IDS=930123749

# ── Storage & Retention ────────────────────────────────────────────────────────
MEDIA_DIR=./data/media
# Days to retain data. Set to 0 to keep forever.
SNAPSHOT_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=90
RAW_RESPONSE_RETENTION_DAYS=7
# Downloaded story/post files older than this are deleted by the daily cleanup
# (already delivered to Telegram; on-demand requests re-download). 0 = keep all.
MEDIA_RETENTION_DAYS=14

# ── Instagram ─────────────────────────────────────────────────────────────────
# Optional: Instagram sessionid cookie for authenticated requests.
IG_SESSION_COOKIE=
# Optional: proxy used specifically for Instagram requests (the Cloudflare
# Worker). Every Instagram endpoint routes through it — a cloud host's own IP
# is blocked outright.
IG_PROXY_URL=
# How many times a 401/403 from the Worker is re-asked. One worker call is
# already 8 upstream attempts, but a repeat call may leave from a different
# Cloudflare colo and Instagram's gate answers differently per colo — so the
# re-ask is a second chance, priced in blocked requests. A sweep multiplies it
# by every account (that traffic is what keeps the gate shut) and leaves the
# second chance to its retry rounds; an on-demand check is one account with
# someone waiting, so it tries every colo it can.
IG_SWEEP_AUTH_ATTEMPTS=1
IG_MANUAL_AUTH_ATTEMPTS=3

# ── Proxy (general outbound) ──────────────────────────────────────────────────
# PROXY_URL wins over HTTP_PROXY / HTTPS_PROXY when set.
PROXY_URL=
HTTP_PROXY=
HTTPS_PROXY=

# ── Web API ───────────────────────────────────────────────────────────────────
# If set, required as X-API-Token header for /sweep and /accounts/*/recheck.
WEB_API_TOKEN=

# ── Runtime ───────────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO
